<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="in.ayurzenix.app.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_chat"
        android:name="in.ayurzenix.app.ui.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/navigation_wallet"
        android:name="in.ayurzenix.app.ui.WalletFragment"
        android:label="Wallet"
        tools:layout="@layout/fragment_wallet" />

    <fragment
        android:id="@+id/navigation_body_scan"
        android:name="in.ayurzenix.app.ui.BodyScanFragment"
        android:label="AI Body Scan"
        tools:layout="@layout/fragment_body_scan" />

    <fragment
        android:id="@+id/navigation_daily_routine"
        android:name="in.ayurzenix.app.ui.home.DailyRoutineFragment"
        android:label="Daily Ayur Routine"
        tools:layout="@layout/fragment_daily_routine" />

    <fragment
        android:id="@+id/navigation_face_scan"
        android:name="in.ayurzenix.app.ui.FaceScanFragment"
        android:label="Face Scan"
        tools:layout="@layout/fragment_face_scan" />

    <fragment
        android:id="@+id/navigation_store"
        android:name="in.ayurzenix.app.ui.StoreFragment"
        android:label="Store"
        tools:layout="@layout/fragment_store" />

    <fragment
        android:id="@+id/navigation_login"
        android:name="in.ayurzenix.app.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/navigation_history"
        android:name="in.ayurzenix.app.ui.HistoryFragment"
        android:label="My History"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/navigation_admin_dashboard"
        android:name="in.ayurzenix.app.ui.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="in.ayurzenix.app.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>
